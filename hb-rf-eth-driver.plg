<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "hb-rf-eth-driver">
<!ENTITY author    "homelab">
<!ENTITY version   "2026.11.06.2">
<!ENTITY kver      "6.18.58-Unraid">
<!ENTITY pkgver    "6.18.58u">
<!ENTITY pkgbuild  "2">
<!ENTITY pkgmd5    "6f1ed29bf3069e60bfb9c202c5d9d9e0">
<!-- TODO: replace with your GitHub user/repo once pushed, e.g. "janedoe/hb-rf-eth-driver-unraid" -->
<!ENTITY repo      "sebastianfs82/hb-rf-eth-driver-unraid">
<!ENTITY baseurl   "https://raw.githubusercontent.com/&repo;/main">
<!ENTITY plugdir   "/boot/config/plugins/&name;">
<!ENTITY pkgfile   "&name;-&pkgver;-x86_64-&pkgbuild;.txz">
<!ENTITY pluginURL "&baseurl;/hb-rf-eth-driver.plg">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" launch="">

<CHANGES>
###2026.11.06.2
- Fix doinst.sh: use absolute path for the module directory check so
  depmod/modprobe actually run on install (was silently skipped before).
###2026.11.06
- Initial build: generic_raw_uart.ko + hb_rf_eth.ko from alexreinert/piVCCU,
  compiled for kernel &kver;
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
RUNNING_KVER="$(uname -r)"
if [[ "${RUNNING_KVER}" != "&kver;" ]]; then
  echo "WARNING: this hb-rf-eth-driver build is for kernel &kver;, but you are running ${RUNNING_KVER}."
  echo "The kernel modules will NOT load until it is rebuilt for ${RUNNING_KVER}."
fi
</INLINE>
</FILE>

<FILE Name="&plugdir;/&pkgfile;" Run="upgradepkg --install-new">
<URL>&baseurl;/&pkgfile;</URL>
<MD5>&pkgmd5;</MD5>
</FILE>

</PLUGIN>
